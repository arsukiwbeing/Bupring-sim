local function AutoEquipLogic()
    task.spawn(function()
        while getgenv().equip do
            task.wait(1)
            local lp = LocalPlayer
            local bp = lp:FindFirstChild("Backpack")
            local char = lp.Character

            if bp and char then
                if not bp:FindFirstChild("Starter Drink") and not char:FindFirstChild("Starter Drink") then
                    char:BreakJoints()
                end

                local leaderstats = lp:FindFirstChild("leaderstats")
                local burpVal = leaderstats and leaderstats:FindFirstChild("Burp points") and leaderstats["Burp points"].Value or 0
                local humanoid = char:FindFirstChildOfClass("Humanoid")

                if humanoid then
                    local toolName = "Starter Drink"
                    if burpVal >= 2000000 then toolName = "Garlic Juice"
                    elseif burpVal >= 1000000 then toolName = "Thunder Fizz"
                    elseif burpVal >= 500000 then toolName = "Omega Burp Juice"
                    elseif burpVal >= 230000 then toolName = "Atomic Drink"
                    elseif burpVal >= 150000 then toolName = "Ninth Drink"
                    elseif burpVal >= 60000 then toolName = "Eighth Drink"
                    elseif burpVal >= 25000 then toolName = "Seventh Drink"
                    elseif burpVal >= 10000 then toolName = "Sixth Drink"
                    elseif burpVal >= 3500 then toolName = "Fifth Drink"
                    elseif burpVal >= 1600 then toolName = "Fourth Drink"
                    elseif burpVal >= 500 then toolName = "Third Drink"
                    elseif burpVal >= 150 then toolName = "Second Drink"
                    end

                    if bp:FindFirstChild("Garlic Juice") then toolName = "Garlic Juice" end
                    
                    local tool = bp:FindFirstChild(toolName)
                    if tool then humanoid:EquipTool(tool) end
                end
            end
        end
    end)
end

createToggle(autoFarmPage, "Auto Equip", function(bool)
    getgenv().equip = bool
    if bool then AutoEquipLogic() end
end)

createToggle(autoFarmPage, "Auto Prestige", function(bool)
