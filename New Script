            if rem and rem:FindFirstChild("PrestigeEvent") then
                rem.PrestigeEvent:FireServer()
            end
            task.wait(0.1)
        end
    end)
end)

createToggle(autoFarmPage, "Auto Collect Gem", function(bool)
    getgenv().autoGem = bool
    task.spawn(function()
        while getgenv().autoGem do
            if Workspace:FindFirstChild("Diamonds") and Workspace.Diamonds:FindFirstChild("Diamond") then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    Workspace.Diamonds.Diamond.CFrame = char.HumanoidRootPart.CFrame
                end
            end
            task.wait()
        end
    end)
end)

createToggle(autoFarmPage, "Auto Drink", function(bool)
    getgenv().autoDrink = bool
    task.spawn(function()
        local drinks = {
            "Starter Drink", "Second Drink", "Third Drink", "Fourth Drink",
            "Fifth Drink", "Sixth Drink", "Seventh Drink", "Eighth Drink",
            "Ninth Drink", "Atomic Drink", "Omega Burp Juice", "Thunder Fizz", "Garlic Juice"
        }
        while getgenv().autoDrink do
            local rem = ReplicatedStorage:FindFirstChild("RemoteEvents")
            if rem and rem:FindFirstChild("DrinkEvent") then
                for _, drink in ipairs(drinks) do
                    rem.DrinkEvent:FireServer(drink)
                end
            end
            task.wait(2.34)
        end
    end)
end)

